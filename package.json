{
  "name": "nestory",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Nestory — A little nest. A lifetime of stories.",
  "scripts": {
    "dev": "vite --port 5178 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5179 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src _test",
    "test": "vitest run",
    "test:python": "python -m unittest discover -s backend/tests -t backend -v",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:python && npm run build",
    "test:e2e": "node _e2e.mjs",
    "test:e2e:anniversary": "node _e2e_anniversary.mjs",
    "test:e2e:autosave": "node _e2e_autosave.mjs",
    "test:e2e:invite": "node _e2e_invite.mjs",
    "test:e2e:reminder": "node _e2e_reminder.mjs",
    "test:e2e:sleep": "node _e2e_sleep.mjs",
    "test:e2e:trash": "node _e2e_trash.mjs",
    "test:e2e:all": "node _e2e_all.mjs",
    "test:e2e:profile": "node _e2e_profile.mjs",
    "test:e2e:settings": "node _e2e_settings.mjs",
    "test:e2e:layout": "node _e2e_layout.mjs",
    "test:e2e:album": "node _e2e_album.mjs",
    "test:e2e:lightbox": "node _e2e_lightbox.mjs",
    "test:e2e:story": "node _e2e_ai_story.mjs",
    "test:e2e:home": "node _e2e_home.mjs",
    "test:e2e:viewport": "node _e2e_viewport.mjs",
    "test:e2e:tap": "node _e2e_tap.mjs",
    "test:e2e:back": "node _e2e_back.mjs",
    "test:e2e:exit": "node _e2e_exit.mjs",
    "test:e2e:auth": "node _e2e_auth.mjs",
    "test:e2e:onboarding": "node _e2e_onboarding.mjs",
    "test:e2e:sheet": "node _e2e_sheet.mjs",
    "shots": "node _shot.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
