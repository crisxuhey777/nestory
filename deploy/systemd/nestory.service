[Unit]
Description=Nestory backend (Python, 127.0.0.1:8000)
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=nestory
Group=nestory
WorkingDirectory=/opt/nestory/backend

# 生产环境：日志写到 /var/log/nestory，Cookie 只走 HTTPS
Environment=PYTHONUNBUFFERED=1
Environment=NESTORY_LOG_DIR=/var/log/nestory
Environment=NESTORY_COOKIE_SECURE=1

# --no-ai-probe：跳过启动时的模型探测，避免 systemd 启动被网络卡住
ExecStart=/opt/nestory/venv/bin/python /opt/nestory/backend/server.py \
    --host 127.0.0.1 --port 8000 --no-ai-probe

Restart=always
RestartSec=3
TimeoutStopSec=15

# 最小权限
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/log/nestory

[Install]
WantedBy=multi-user.target
