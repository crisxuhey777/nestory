# ============================================================
# Nestory 部署配置：复制成 .env 再改（.env 已被 gitignore，不要提交）
#   cp .env.example .env
#   openssl rand -base64 24        # 生成密码用
# ============================================================

# ---------- 必填 ----------
# 你的域名（先在 DNS 里把 A 记录指到服务器 IP，再启动）
DOMAIN=nestory.example.com

# MySQL 密码：两个都换成 24 位以上随机串，不要含 $ ' " 空格
NESTORY_DB_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# ---------- 数据库 ----------
NESTORY_DB_NAME=nestory
NESTORY_DB_USER=nestory

# ---------- 上线必改 ----------
# 生产环境必须为 1：会话 Cookie 只允许 HTTPS 传输
NESTORY_COOKIE_SECURE=1
# 关掉演示账号的「恢复示例数据」特权（空字符串 = 关闭，不是留一行注释）
NESTORY_DEMO_EMAIL=

# ---------- 媒体 ----------
# 字节存在宿主机 ./data/media（上限 = NESTORY_MEDIA_QUOTA_MB 兆）
NESTORY_MEDIA_MAX_MB=200
NESTORY_MEDIA_QUOTA_MB=5120

# 想改用 S3 兼容存储（Cloudflare R2 / 阿里云 OSS / MinIO）就填这组，
# 填齐后自动切换到 s3 驱动，媒体不再占 VPS 磁盘：
# NESTORY_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# NESTORY_S3_BUCKET=nestory
# NESTORY_S3_REGION=auto
# NESTORY_S3_ACCESS_KEY=
# NESTORY_S3_SECRET_KEY=
# NESTORY_S3_PREFIX=nestory

# ---------- AI（OpenAI 兼容接口，这里是智谱免费档） ----------
NESTORY_LLM_BASE=https://open.bigmodel.cn/api/paas/v4/chat/completions
NESTORY_LLM_KEY=
NESTORY_LLM_MODEL=glm-4-flash
NESTORY_LLM_TIMEOUT=45

NESTORY_VISION_BASE=https://open.bigmodel.cn/api/paas/v4/chat/completions
NESTORY_VISION_KEY=
NESTORY_VISION_MODEL=glm-4v-flash

# ---------- 备份 ----------
# 应用自带的每日 JSON 备份（写进 ./data/media/backups），保留 14 份
NESTORY_BACKUP_ENABLED=1
NESTORY_BACKUP_KEEP=14
NESTORY_BACKUP_AT=03:30

# ---------- 其它 ----------
# 显示在 /api/health 与「关于」页
NESTORY_VERSION=3.0.0
