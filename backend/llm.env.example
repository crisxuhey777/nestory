# 复制成 backend/llm.env 后按需修改；改完重启后端生效。
# 真实环境变量优先于本文件。默认（不建本文件）用 Pollinations 免费 GET 接口，无需 Key。

# ---- 方案 A：只换 Pollinations 的模型，不填 BASE/KEY ----
# NESTORY_LLM_MODEL=openai-fast

# ---- 方案 B：任何 OpenAI 兼容服务（示例：智谱 GLM-4-Flash，免费额度）----
# NESTORY_LLM_BASE=https://open.bigmodel.cn/api/paas/v4/chat/completions
# NESTORY_LLM_KEY=sk-xxxxxxxx
# NESTORY_LLM_MODEL=glm-4-flash

# ---- 可选：超时秒数 ----
# NESTORY_LLM_TIMEOUT=45

# ---- 可选：视觉模型（只用于相册「帮我想一句」）----
# 不填时按钮会提示「视觉模型还没配置」，手动输入不受影响。
# Key 只写在 backend/llm.env，已被 .gitignore 忽略，不会进入前端或日志。
# NESTORY_VISION_BASE=https://open.bigmodel.cn/api/paas/v4/chat/completions
# NESTORY_VISION_KEY=sk-xxxxxxxx
# NESTORY_VISION_MODEL=glm-4v-flash
